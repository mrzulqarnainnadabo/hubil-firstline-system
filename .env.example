# FirstLine / Hubil Group — environment template
# Copy to .env and fill values as needed. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Optional: Notion integration for Hubil Clients database
# NOTION_API_KEY=secret_xxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Manus / Forge storage (used by vite-plugin for image proxy in dev)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
