# FirstLine / Hubil Group — environment template
# Copy to .env and fill values as needed. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Notion → Hubil Clients database
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Share the "Hubil Clients" database with that integration
# 3. Paste the integration secret and the database ID below
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=86a2b54bbdf247b2831923cb6590aa82

# --- Founder alerts (High priority only) ---
# WhatsApp via Twilio (optional). Both FROM and TO need whatsapp: prefix.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# FOUNDER_WHATSAPP_TO=whatsapp:+234XXXXXXXXXX

# Email via Resend (optional)
# RESEND_API_KEY=re_xxxxxxxx
# FOUNDER_EMAIL_TO=you@hubil.example
# NOTIFY_EMAIL_FROM=FirstLine <alerts@yourdomain.com>

# Optional: Manus / Forge storage (used by vite-plugin for image proxy in dev)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
